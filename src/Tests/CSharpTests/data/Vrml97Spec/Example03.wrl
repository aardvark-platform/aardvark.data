# [Scene] ========== ========== ==========
WorldInfo {
  title "Example03.x3d"
}
Transform {
  children [
      Shape {
        geometry Sphere {
        }
      }
      Transform {
        translation 2.0 0.0 0.0
        children [
                  DEF Joe Shape {
              geometry Sphere {
                radius 0.2
              }
            }
        ]
      }
      Transform {
        translation -2.0 0.0 0.0
        children [
                  USE Joe
        ]
      }
  ]
}
