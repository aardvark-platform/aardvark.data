# [Scene] ========== ========== ==========
WorldInfo {
  title "Example11.x3d"
}
LOD {
  range [ 10.0 50.0 ]
  level [
    LOD {
      level [
        Shape {
          geometry Sphere {
          }
          appearance DEF DefaultAppearance Appearance {
            material Material {
            }
          }
        }
        DEF LoRes Shape {
          geometry Box {
          }
          appearance USE DefaultAppearance
        }
      ]
    }
    USE LoRes
    Shape {
    }
  ]
}
