# [Scene] ========== ========== ==========
WorldInfo {
  title "Example08.x3d"
}
Anchor {
  description "example link"
  parameter [ "target=name_of_frame" ]
  url [ "http://somehost/somefile.html" ]
  children [
      Shape {
        geometry Cylinder {
        }
        appearance DEF DefaultAppearance Appearance {
          material Material {
          }
        }
      }
  ]
}
Anchor {
  description "another example link"
  url [ "http://www.school.edu/vrml/someScene.wrl#OverView" ]
  children [
      Shape {
        geometry Box {
        }
        appearance USE DefaultAppearance
      }
  ]
}
# Doorway Viewpoint added.
DEF Doorway Viewpoint {
  description "Example view"
}
# Error in the VRML 97 specification example: the following Anchor url did not point to a Viewpoint. Doorway Viewpoint needed.
Anchor {
  description "Doorway viewpoint"
  url [ "#Doorway" ]
  children [
      Shape {
        geometry Sphere {
        }
      }
  ]
}
